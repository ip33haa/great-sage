# Gemini key for Zariah's memory lines and the fallback voice (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional URL of a VOICEVOX engine for the Japanese voices. Leave empty on Vercel unless you host one.
VOICEVOX_URL=

# Local only: path to VOICEVOX's vv-engine\run.exe, started automatically by `npm run dev`.
VOICEVOX_ENGINE_PATH=
